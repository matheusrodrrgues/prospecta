# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this key with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects cron/ingestion endpoints.
CRON_SECRET=
PIPELINE_WEBHOOK_URL=
PIPELINE_WEBHOOK_SECRET=

# Optional object storage configuration.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_GEO_TILES_URL=https://storage.googleapis.com/prospecta40-tiles
TITILER_BASE_URL=

# Optional anti-bot protection for public contributions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
